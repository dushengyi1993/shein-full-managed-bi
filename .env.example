# Local read-only dashboard
FULL_BI_HOST=127.0.0.1
FULL_BI_PORT=3100
FULL_BI_DATA_FILE=tests/fixtures/dashboard.json

# Required together outside loopback development. Keep the JSON file private.
# Supported credentials: passwordSha256 (64 hex chars), passwordHash using
# pbkdf2:sha256:<iterations>:<saltHex>:<hashHex>, or strict Apache $apr1$
# htpasswdHash for compatibility. Prefer PBKDF2-SHA256 for new production users.
FULL_BI_AUTH_USERS_FILE=
# Backward-compatible alias used by the production systemd unit: FULL_BI_AUTH_FILE
FULL_BI_SESSION_SECRET=
# Prefer this root-owned/read-only file over putting the secret value in the environment.
FULL_BI_SESSION_SECRET_FILE=
FULL_BI_SESSION_TTL_SECONDS=2592000
FULL_BI_AUTH_MAX_ATTEMPTS=5
FULL_BI_AUTH_WINDOW_MS=900000
FULL_BI_AUTH_MAX_BODY_BYTES=16384
FULL_BI_AUTH_MAX_CLIENTS=10000
FULL_BI_AUTH_MAX_CONCURRENT_KDFS=8
# Leave empty for the safe default: true in production, false in local development.
FULL_BI_COOKIE_SECURE=
# Enable only when the app is reachable exclusively through the trusted reverse proxy.
FULL_BI_TRUST_PROXY=false
FULL_BI_PUBLIC_ORIGIN=
FULL_BI_REQUEST_TIMEOUT_MS=15000
FULL_BI_HEADERS_TIMEOUT_MS=10000

# PostgreSQL connection for local tooling or the isolated cloud warehouse. Never commit a real value.
DATABASE_URL=

# Independent remote authorization broker. Keep it on a separate loopback port.
# The application file contains only the DL full-managed app credentials.
# The state file stores hashes and sanitized status only; receipts are staged
# for explicit administrator review and are never activated automatically.
FULL_AUTH_HOST=127.0.0.1
FULL_AUTH_PORT=8789
FULL_AUTH_PUBLIC_ORIGIN=https://fm.dushengyi.cc
FULL_AUTH_COOKIE_SECURE=true
FULL_AUTH_APPLICATION_STORE=DL
FULL_AUTH_APPLICATION_FILE=
FULL_AUTH_STATE_FILE=
FULL_AUTH_RECEIPT_DIRECTORY=
# Root-owned first-party truth used only by the administrator finalizer.
# It maps each internal storeCode to one independently verified SHEIN supplierId.
FULL_AUTH_IDENTITY_MAP_FILE=
FULL_AUTH_STATE_TTL_SECONDS=600
FULL_AUTH_MAX_STORE_ATTEMPTS=6
FULL_AUTH_REQUEST_TIMEOUT_MS=30000
FULL_AUTH_HEADERS_TIMEOUT_MS=10000
# Required for real SHEIN OpenAPI calls on the non-Windows cloud runtime.
SHEIN_FM_CLOUD_EXECUTION=0
