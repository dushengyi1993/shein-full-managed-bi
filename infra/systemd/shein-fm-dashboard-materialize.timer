[Unit]
Description=Fallback refresh of SHEIN full-managed dashboard JSON
ConditionPathExists=/srv/shein-fm/runtime/materializer.enabled

[Timer]
OnCalendar=*-*-* 00,06,12,18:55:00 Asia/Shanghai
AccuracySec=1m
Persistent=false
Unit=shein-fm-dashboard-materialize.service

# Domain jobs enqueue a coalesced projection consumed by the two-minute pending
# timer. This six-hour timer is only a low-frequency fallback for an external
# repair that forgot to enqueue, and has no boot trigger.

[Install]
WantedBy=timers.target
