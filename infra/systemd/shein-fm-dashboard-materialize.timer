[Unit]
Description=Fallback refresh of SHEIN full-managed dashboard JSON
ConditionPathExists=/srv/shein-fm/runtime/materializer.enabled

[Timer]
OnBootSec=2m
OnUnitInactiveSec=30m
RandomizedDelaySec=2m
Persistent=true
Unit=shein-fm-dashboard-materialize.service

# Domain jobs trigger materialization immediately through OnSuccess. This timer
# is only a bounded fallback if an external read-only repair writes facts without
# an explicit projection trigger.

[Install]
WantedBy=timers.target
