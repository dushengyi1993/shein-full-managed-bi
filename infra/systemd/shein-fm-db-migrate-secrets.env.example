# Install as:
#   /srv/shein-fm/secrets/db-migrate/runtime-role-passwords.env
# Ownership and mode:
#   root:root 0600
#
# Empty values deliberately fail closed. For the first least-privilege rollout,
# SHEIN_FM_APP_DB_PASSWORD must be the exact current production value: migration
# 0002 commits before 9999, so rotating this legacy password here could disconnect
# the old runtime if a later migration fails. Generate six new, mutually
# independent URL-safe secrets of at least 24 characters for the six new LOGIN
# roles. Do not reuse the legacy password for a new role.
#
# SHEIN_FM_WEBAPI_LOGIN_DB_PASSWORD belongs to the isolated, NOINHERIT WebAPI
# experiment login added by migration 0012. It must be a sixth independent secret
# and must never be shared with a sales, supply, webhook or materializer role.
SHEIN_FM_APP_DB_PASSWORD=
SHEIN_FM_MATERIALIZER_DB_PASSWORD=
SHEIN_FM_SALES_DB_PASSWORD=
SHEIN_FM_SUPPLY_DB_PASSWORD=
SHEIN_FM_WEBHOOK_INGRESS_DB_PASSWORD=
SHEIN_FM_WEBHOOK_WORKER_DB_PASSWORD=
SHEIN_FM_WEBAPI_LOGIN_DB_PASSWORD=
