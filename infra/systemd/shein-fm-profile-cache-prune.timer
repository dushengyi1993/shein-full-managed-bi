[Unit]
Description=Weekly SHEIN full-managed WebAPI Profile cache prune

[Timer]
# Weekly and well away from the nightly sync/backup window. The tool fails closed
# when a Profile is in use, so a skipped week is safe.
OnCalendar=Sun *-*-* 04:40:00 Asia/Shanghai
RandomizedDelaySec=10m
Persistent=false
Unit=shein-fm-profile-cache-prune.service

[Install]
WantedBy=timers.target
