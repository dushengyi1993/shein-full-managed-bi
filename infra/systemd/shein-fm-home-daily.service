[Unit]
Description=Settle one five-store batch of SHEIN full-managed homepage history
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
OnSuccess=shein-fm-dashboard-materialize.service
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/all-25-completed

[Service]
Type=oneshot
User=sheinfm
Group=sheinfm
Slice=shein-fm-heavy.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/shein-fm/secrets/webapi-experiment/database.env
RuntimeDirectory=shein-fm-webapi
RuntimeDirectoryMode=0700
ExecCondition=/usr/bin/node scripts/check_full_managed_resource_pressure.mjs --class=browser --systemd-condition
ExecStart=/usr/bin/flock -n -E 75 /run/lock/shein-fm-heavy.lock /usr/bin/flock -n -E 75 /run/shein-fm-webapi/home-history.lock /usr/bin/node scripts/run_full_managed_scheduled_task.mjs --task=home-daily-batch --execute
SuccessExitStatus=75
TimeoutStartSec=35min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Nice=10
CPUWeight=20
CPUQuota=75%
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=500
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/webapi-experiment/database.env
ReadWritePaths=/run/lock/shein-fm-heavy.lock /run/shein-fm-webapi /srv/shein-fm/runtime/webapi-locks /srv/shein-fm/webapi/profiles
MemoryHigh=1100M
MemoryMax=1600M
MemorySwapMax=128M
