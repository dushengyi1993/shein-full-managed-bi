[Unit]
Description=Refresh SHEIN full-managed read-only supply facts
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
OnSuccess=shein-fm-dashboard-materialize.service
ConditionPathExists=/srv/shein-fm/runtime/supply-sync.enabled
ConditionPathExists=/srv/shein-fm/runtime/supply-backfill.verified

[Service]
Type=oneshot
User=sheinfm-supply
Group=sheinfm-supply
SupplementaryGroups=sheinfm-dashboard
Slice=shein-fm-heavy.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/supply/openapi.json
Environment=FULL_BI_COORDINATOR_STATE_DIR=/srv/shein-fm/runtime/coordinator/supply
EnvironmentFile=/srv/shein-fm/secrets/supply/database.env
RuntimeDirectory=shein-fm-supply
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/node scripts/run_full_managed_business_coordinator.mjs --task=supply-daily --execute
TimeoutStartSec=60min
TimeoutStopSec=20s
KillMode=control-group
SendSIGKILL=yes
Nice=10
CPUWeight=20
CPUQuota=60%
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=400
TasksMax=96
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/supply/openapi.json
ReadOnlyPaths=/srv/shein-fm/secrets/supply/database.env
ReadWritePaths=/run/lock/shein-api-light-0.lock /run/lock/shein-api-light-1.lock /run/shein-fm-supply /srv/shein-fm/runtime/coordinator/supply
MemoryHigh=512M
MemoryMax=1024M
MemorySwapMax=64M

# This unit is intentionally not enabled by deployment. Before creating the
# gate, run an explicit historical load, for example:
# node scripts/sync_full_managed_supply.mjs --mode backfill \
#   --backfill-start 2025-01-01T00:00:00+08:00 --stores DL5477
# Then verify warehouse coverage and a normal incremental run. Only after that
# readback may deployment create supply-backfill.verified and supply-sync.enabled.
# The service default is incremental and never claims historical completeness.

[Install]
WantedBy=multi-user.target
