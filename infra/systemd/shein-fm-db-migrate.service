[Unit]
Description=Migrate and verify SHEIN full-managed PostgreSQL
Requires=shein-fm-db.service
After=shein-fm-db.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/shein-fm/current
EnvironmentFile=/srv/shein-fm/secrets/db-migrate/runtime-role-passwords.env
ExecStart=/usr/bin/bash scripts/migrate_full_managed_db.sh
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/shein-fm/secrets/db-migrate/runtime-role-passwords.env

[Install]
WantedBy=multi-user.target
