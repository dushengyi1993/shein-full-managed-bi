[Unit]
Description=Near-term retry for deferred SHEIN full-managed dashboard materialization
ConditionPathExists=/srv/shein-fm/runtime/materializer.enabled

[Timer]
OnCalendar=*-*-* *:00/2:00 Asia/Shanghai
AccuracySec=15s
Persistent=false
Unit=shein-fm-dashboard-materialize-retry.service

# The service performs only a cheap marker check when no fact domain changed.
# Multiple successful jobs within two minutes collapse into one projection. A
# failed/blocked build keeps the marker for a later retry; old JSON stays live.

[Install]
WantedBy=timers.target
