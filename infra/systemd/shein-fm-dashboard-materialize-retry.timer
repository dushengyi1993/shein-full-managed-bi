[Unit]
Description=Near-term retry for deferred SHEIN full-managed dashboard materialization
ConditionPathExists=/srv/shein-fm/runtime/materializer.enabled

[Timer]
OnCalendar=*-*-* *:09,19,29,39,49,59:00 Asia/Shanghai
AccuracySec=15s
Persistent=false
Unit=shein-fm-dashboard-materialize-retry.service

# Primary wake-up is event-driven through the path unit. This ten-minute timer
# is only a bounded fallback when the immediate attempt was pressure-deferred.


[Install]
WantedBy=timers.target
