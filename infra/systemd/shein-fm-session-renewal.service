[Unit]
Description=Validate all full-managed HTTP sessions and recover only expired Profiles
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi
Wants=network-online.target
After=network-online.target systemd-tmpfiles-setup.service
ConditionPathExists=/srv/shein-fm/runtime/store-login/renewal.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/state.json

[Service]
Type=oneshot
User=sheinfm
Group=sheinfm
SupplementaryGroups=sheinfm-dashboard
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=FULL_BI_COORDINATOR_STATE_DIR=/srv/shein-fm/runtime/coordinator/session
EnvironmentFile=/srv/shein-fm/secrets/webapi-experiment/database.env
LoadCredential=webapi_session_key:/srv/shein-fm/secrets/webapi-session/session-key
RuntimeDirectory=shein-fm-webapi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/node scripts/run_full_managed_business_coordinator.mjs --task=session-maintenance --execute
TimeoutStartSec=25min
TimeoutStopSec=20s
KillMode=control-group
SendSIGKILL=yes
Nice=8
CPUWeight=30
CPUQuota=60%
IOWeight=25
OOMPolicy=stop
OOMScoreAdjust=400
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/lock/shein-api-light-0.lock /run/lock/shein-api-light-1.lock /run/lock/shein-host-heavy.lock /run/lock/shein-browser-read-0.lock /run/lock/shein-browser-read-1.lock /run/shein-fm-webapi /srv/shein-fm/runtime/store-login /srv/shein-fm/runtime/webapi-locks /srv/shein-fm/runtime/webapi-sessions /srv/shein-fm/runtime/coordinator/session /srv/shein-fm/webapi/profiles
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=128M
