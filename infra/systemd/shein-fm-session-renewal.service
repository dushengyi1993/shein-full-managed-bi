[Unit]
Description=Renew saved-password sessions for full-managed SHEIN Profiles
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi
Wants=network-online.target
After=network-online.target shein-fm-store-login.service systemd-tmpfiles-setup.service
Requires=shein-fm-db.service
RequiresMountsFor=/data /srv/shein-fm/runtime /srv/shein-fm/webapi/profiles
ConditionPathExists=/srv/shein-fm/runtime/store-login/renewal.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/state.json

[Service]
Type=oneshot
User=sheinfm
Group=sheinfm
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/shein-fm/secrets/webapi-experiment/database.env
RuntimeDirectory=shein-fm-webapi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# History reads and renewal both own a Chrome Profile. Skip this renewal slot
# when a history run is active; the next daily slot will retry.
ExecStart=/usr/bin/flock -n -E 75 /run/lock/shein-host-heavy.lock /usr/bin/flock -n -E 75 /run/lock/shein-fm-heavy.lock /usr/bin/flock -n -E 75 /run/shein-fm-webapi/home-history.lock /usr/bin/flock -n -E 75 /srv/shein-fm/runtime/store-login/renewal.lock /usr/bin/bash scripts/run_full_managed_resource_guarded.sh browser /usr/bin/node scripts/renew_full_managed_webapi_sessions.mjs
SuccessExitStatus=75
TimeoutStartSec=10min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Nice=10
CPUWeight=20
CPUQuota=75%
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=500
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/webapi-experiment/database.env
ReadWritePaths=/run/lock/shein-host-heavy.lock /run/lock/shein-fm-heavy.lock /run/shein-fm-webapi /srv/shein-fm/runtime/store-login /srv/shein-fm/runtime/webapi-locks /srv/shein-fm/webapi/profiles
MemoryHigh=1100M
MemoryMax=1600M
MemorySwapMax=128M
