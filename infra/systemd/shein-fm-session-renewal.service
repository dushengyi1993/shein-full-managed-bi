[Unit]
Description=Refresh encrypted full-managed WebAPI sessions without opening Chrome Profiles
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi
Wants=network-online.target
After=network-online.target systemd-tmpfiles-setup.service
ConditionPathExists=/srv/shein-fm/runtime/store-login/renewal.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/state.json

[Service]
Type=oneshot
User=sheinfm
Group=sheinfm
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
LoadCredential=webapi_session_key:/srv/shein-fm/secrets/webapi-session/session-key
RuntimeDirectory=shein-fm-webapi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/bash scripts/run_shein_host_lane.sh api-light fm openapi /usr/bin/flock -n -E 75 /srv/shein-fm/runtime/store-login/renewal.lock /usr/bin/node scripts/renew_full_managed_webapi_sessions.mjs
# Store-level expiry writes a recovery queue and exit 2; that is a handled
# condition, not a scheduler failure. The browser recovery unit consumes only
# the affected stores.
SuccessExitStatus=2 75
TimeoutStartSec=5min
TimeoutStopSec=20s
KillMode=control-group
SendSIGKILL=yes
Nice=8
CPUWeight=30
CPUQuota=60%
IOWeight=25
OOMPolicy=stop
OOMScoreAdjust=400
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/lock/shein-api-light-0.lock /run/lock/shein-api-light-1.lock /run/shein-fm-webapi /srv/shein-fm/runtime/store-login /srv/shein-fm/runtime/webapi-sessions
MemoryHigh=256M
MemoryMax=512M
MemorySwapMax=64M
