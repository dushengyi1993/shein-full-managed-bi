[Unit]
Description=Recover only expired full-managed WebAPI sessions through saved Profile credentials
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-store-login.service shein-fm-db.service systemd-tmpfiles-setup.service
ConditionPathExists=/srv/shein-fm/runtime/store-login/session-recovery.json
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled

[Service]
Type=oneshot
User=sheinfm
Group=sheinfm
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/shein-fm/secrets/webapi-experiment/database.env
LoadCredential=webapi_session_key:/srv/shein-fm/secrets/webapi-session/session-key
RuntimeDirectory=shein-fm-webapi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/bash scripts/run_shein_host_lane.sh browser-read fm browser /usr/bin/flock -n -E 75 /srv/shein-fm/runtime/store-login/renewal.lock /usr/bin/node scripts/recover_full_managed_webapi_sessions.mjs
SuccessExitStatus=2 75
TimeoutStartSec=12min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Nice=10
CPUWeight=20
CPUQuota=75%
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=500
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/webapi-experiment/database.env
ReadWritePaths=/run/lock/shein-host-heavy.lock /run/lock/shein-browser-read-0.lock /run/lock/shein-browser-read-1.lock /run/shein-fm-webapi /srv/shein-fm/runtime/store-login /srv/shein-fm/runtime/webapi-locks /srv/shein-fm/runtime/webapi-sessions /srv/shein-fm/webapi/profiles
MemoryHigh=1100M
MemoryMax=1600M
MemorySwapMax=128M
