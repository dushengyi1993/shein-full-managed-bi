[Unit]
Description=Refresh current-day SHEIN full-managed homepage facts
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
OnSuccess=shein-fm-dashboard-materialize.service
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/all-25-completed

[Service]
Type=oneshot
User=sheinfm
Group=sheinfm
SupplementaryGroups=sheinfm-dashboard
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_FM_WEBAPI_TRANSPORT=http
Environment=FULL_BI_COORDINATOR_STATE_DIR=/srv/shein-fm/runtime/coordinator/realtime
Environment=FULL_BI_SALES_OPENAPI_CONFIG_FILE=%d/sales_openapi_config
EnvironmentFile=/srv/shein-fm/secrets/webapi-experiment/database.env
EnvironmentFile=/srv/shein-fm/secrets/sales/database.env
LoadCredential=webapi_session_key:/srv/shein-fm/secrets/webapi-session/session-key
LoadCredential=sales_openapi_config:/srv/shein-fm/secrets/sales/openapi.json
RuntimeDirectory=shein-fm-webapi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/node scripts/run_full_managed_business_coordinator.mjs --task=realtime-cockpit --execute
TimeoutStartSec=12min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Nice=5
CPUWeight=50
CPUQuota=90%
IOWeight=40
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=500
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/webapi-experiment/database.env
ReadWritePaths=/run/lock/shein-api-light-0.lock /run/lock/shein-api-light-1.lock /run/shein-fm-webapi /run/shein-fm-coordinator /srv/shein-fm/runtime/webapi-sessions /srv/shein-fm/runtime/coordinator/realtime
MemoryHigh=512M
MemoryMax=900M
MemorySwapMax=128M
