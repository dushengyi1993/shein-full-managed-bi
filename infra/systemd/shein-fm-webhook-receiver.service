[Unit]
Description=SHEIN full-managed Webhook receiver
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service
ConditionPathExists=/srv/shein-fm/runtime/webhook-ingress.enabled

[Service]
Type=simple
User=sheinfm-webhook-ingress
Group=sheinfm-webhook-ingress
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=FULL_BI_WEBHOOK_HOST=127.0.0.1
Environment=FULL_BI_WEBHOOK_PORT=8793
Environment=FULL_BI_WEBHOOK_DB_POOL_MAX=4
Environment=FULL_BI_WEBHOOK_DB_APPLICATION_NAME=shein_fm_webhook_receiver
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/webhook-ingress/stores.json
Environment=FULL_BI_WEBHOOK_APPLICATION_FILE=/srv/shein-fm/secrets/webhook-ingress/application.secret.json
EnvironmentFile=/srv/shein-fm/secrets/webhook-ingress/database.env
ExecStart=/usr/bin/node scripts/serve_full_managed_webhook.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/webhook-ingress/stores.json
ReadOnlyPaths=/srv/shein-fm/secrets/webhook-ingress/application.secret.json
ReadOnlyPaths=/srv/shein-fm/secrets/webhook-ingress/database.env
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
