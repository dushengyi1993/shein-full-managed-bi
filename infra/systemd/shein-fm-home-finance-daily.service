[Unit]
Description=Refresh settled SHEIN full-managed finance windows
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
OnSuccess=shein-fm-dashboard-materialize.service
OnFailure=shein-fm-dashboard-materialize.service
ConditionPathExists=/srv/shein-fm/runtime/home-finance-backfill.enabled

[Service]
Type=oneshot
User=sheinfm-sales
Group=sheinfm-sales
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/sales/openapi.json
EnvironmentFile=/srv/shein-fm/secrets/sales/database.env
RuntimeDirectory=shein-fm-sales
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n -E 75 /run/lock/shein-host-heavy.lock /usr/bin/flock -n -E 75 /run/lock/shein-fm-heavy.lock /usr/bin/flock -n -E 75 /run/shein-fm-sales/home-finance-daily.lock /usr/bin/bash scripts/run_full_managed_resource_guarded.sh openapi /usr/bin/node scripts/run_full_managed_scheduled_task.mjs --task=finance-daily --execute
SuccessExitStatus=75
TimeoutStartSec=15min
TimeoutStopSec=20s
KillMode=control-group
SendSIGKILL=yes
Nice=10
CPUWeight=20
CPUQuota=60%
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=400
TasksMax=96
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/sales/openapi.json
ReadOnlyPaths=/srv/shein-fm/secrets/sales/database.env
ReadWritePaths=/run/lock/shein-host-heavy.lock /run/lock/shein-fm-heavy.lock /run/shein-fm-sales
MemoryHigh=512M
MemoryMax=1024M
MemorySwapMax=64M
