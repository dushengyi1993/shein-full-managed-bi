[Unit]
Description=Materialize SHEIN full-managed dashboard JSON from the warehouse
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service
ConditionPathExists=/srv/shein-fm/runtime/materializer.enabled

[Service]
Type=oneshot
User=sheinfm-materializer
Group=sheinfm-materializer
SupplementaryGroups=sheinfm-dashboard
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=FULL_BI_DATA_FILE=/srv/shein-fm/runtime/dashboard/dashboard.next.json
EnvironmentFile=/srv/shein-fm/secrets/materializer/database.env
ExecStart=/usr/bin/node scripts/materialize_full_managed_dashboard.mjs
ExecStartPost=/usr/bin/chgrp sheinfm-dashboard /srv/shein-fm/runtime/dashboard/dashboard.next.json
ExecStartPost=/usr/bin/chmod 0640 /srv/shein-fm/runtime/dashboard/dashboard.next.json
ExecStartPost=/usr/bin/mv -f /srv/shein-fm/runtime/dashboard/dashboard.next.json /srv/shein-fm/runtime/dashboard/dashboard.json
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/materializer/database.env
ReadWritePaths=/srv/shein-fm/runtime/dashboard
MemoryHigh=768M
MemoryMax=1536M

# The materializer writes a private staging file. Only after a successful
# projection is it made group-readable and atomically promoted for the portal.
# Platform credentials are intentionally unavailable to this unit.

[Install]
WantedBy=multi-user.target
