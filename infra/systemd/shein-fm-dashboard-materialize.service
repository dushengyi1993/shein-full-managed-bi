[Unit]
Description=Materialize SHEIN full-managed dashboard JSON from the warehouse
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
ConditionPathExists=/srv/shein-fm/runtime/materializer.enabled

[Service]
Type=oneshot
User=sheinfm-materializer
Group=sheinfm-materializer
SupplementaryGroups=sheinfm-dashboard
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=1024
Environment=FULL_BI_DATA_FILE=/srv/shein-fm/runtime/dashboard/dashboard.next.json
EnvironmentFile=/srv/shein-fm/secrets/materializer/database.env
ExecStart=/usr/bin/flock -n -E 75 /run/lock/shein-host-heavy.lock /usr/bin/flock -n -E 75 /run/lock/shein-fm-heavy.lock /usr/bin/bash scripts/run_full_managed_resource_guarded.sh materializer /usr/bin/bash scripts/materialize_and_promote_full_managed_dashboard.sh
SuccessExitStatus=75
TimeoutStartSec=10min
TimeoutStopSec=20s
KillMode=control-group
SendSIGKILL=yes
Nice=12
CPUWeight=15
CPUQuota=50%
IOWeight=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=400
TasksMax=96
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/materializer/database.env
ReadWritePaths=/run/lock/shein-host-heavy.lock /run/lock/shein-fm-heavy.lock /srv/shein-fm/runtime/dashboard
MemoryHigh=640M
MemoryMax=1024M
MemorySwapMax=64M
LimitCORE=0

# The materializer writes a private staging file. Only after a successful
# projection is it made group-readable and atomically promoted for the portal.
# Platform credentials are intentionally unavailable to this unit.

[Install]
WantedBy=multi-user.target
