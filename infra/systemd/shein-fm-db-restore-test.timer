[Unit]
Description=Monthly restore verification for SHEIN full-managed backups

[Timer]
# First Sunday of each month. One :32 homepage batch may defer while the full
# restore is running; hourly OpenAPI sales remains in the independent fast lane.
OnCalendar=Sun *-*-01..07 11:15:00 Asia/Shanghai
AccuracySec=5m
RandomizedDelaySec=5m
Persistent=false
Unit=shein-fm-db-restore-test.service

[Install]
WantedBy=timers.target
