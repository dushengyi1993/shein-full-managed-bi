[Unit]
Description=Daily SHEIN full-managed backup retention and COS archive

[Timer]
# Runs after the 12:32 core window and must finish before the 13:20 ET lane.
OnCalendar=*-*-* 12:45:00 Asia/Shanghai
AccuracySec=1m
Persistent=false
Unit=shein-fm-backup-archive.service

[Install]
WantedBy=timers.target
