[Unit]
Description=Observe SHEIN full-managed root filesystem pressure
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
WorkingDirectory=/opt/shein-fm/current
# Observe only: this unit never scans, prunes or deletes anything. A critical
# reading (>=85%) exits non-zero so the unit is visibly failed for ops.
ExecStart=/usr/bin/node scripts/guard_full_managed_disk.mjs
ReadWritePaths=/srv/shein-fm/runtime
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
