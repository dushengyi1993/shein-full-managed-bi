[Unit]
Description=Refresh SHEIN full-managed current-day homepage facts after platform settlement
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/all-25-completed

[Timer]
OnCalendar=*-*-* *:02:00 Asia/Shanghai
AccuracySec=1s
Persistent=false
Unit=shein-fm-home-realtime.service

[Install]
WantedBy=timers.target
