[Unit]
Description=Backfill all full-managed homepage finance history
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service
RequiresMountsFor=/data /srv/shein-fm/runtime
ConditionPathExists=/srv/shein-fm/runtime/home-finance-backfill.enabled

[Service]
Type=oneshot
User=sheinfm-sales
Group=sheinfm-sales
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/sales/openapi.json
EnvironmentFile=/srv/shein-fm/secrets/sales/database.env
RuntimeDirectory=shein-fm-sales
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/shein-fm-sales/home-finance-backfill.lock /usr/bin/node scripts/sync_full_managed_home_finance.mjs --stores=CX4412,XL2801,QY8886,DX0571,NM7397,LQ7173,TS8263,DL5477,FY4021,GJ8989,QH8028,JY8060,ZL3133,MZ2406,YJ8177,RH0099,WY9025,RH2848,CX2816,YJ4042,NM4977,NM8787,NM8831,NM7418,DX2420 --from=2024-01-01 --to=2026-07-30 --concurrency=2 --execute
TimeoutStartSec=24h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/sales/openapi.json
ReadOnlyPaths=/srv/shein-fm/secrets/sales/database.env
ReadWritePaths=/run/shein-fm-sales /srv/shein-fm/runtime
MemoryHigh=1G
MemoryMax=2G
