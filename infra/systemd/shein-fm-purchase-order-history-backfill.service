[Unit]
Description=Backfill all verified full-managed purchase-order history
Documentation=https://github.com/dushengyi1993/shein-full-managed-bi
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service shein-fm-home-finance-backfill.service
OnSuccess=shein-fm-dashboard-materialize.service
RequiresMountsFor=/data /srv/shein-fm/runtime
ConditionPathExists=/srv/shein-fm/runtime/purchase-order-history.enabled

[Service]
Type=oneshot
User=sheinfm-supply
Group=sheinfm-supply
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/supply/openapi.json
EnvironmentFile=/srv/shein-fm/secrets/supply/database.env
EnvironmentFile=/srv/shein-fm/secrets/openapi-proxy.env
RuntimeDirectory=shein-fm-supply
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Reuse the normal supply lock. A history run waits for the current incremental
# sync to finish, then future timer runs fail their own non-blocking lock instead
# of overlapping the same OpenAPI and warehouse writers.
ExecStart=/usr/bin/flock /run/shein-fm-supply/sync.lock /usr/bin/node scripts/backfill_full_managed_purchase_order_history.mjs --execute --approved-manifest-hash=e2b5adf1f6f1690e4d4f12255484b87e06890050fe732f23f1a6fb06df95cd50
TimeoutStartSec=72h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/supply/openapi.json
ReadOnlyPaths=/srv/shein-fm/secrets/supply/database.env
ReadWritePaths=/run/shein-fm-supply /srv/shein-fm/runtime
MemoryHigh=1G
MemoryMax=2G
