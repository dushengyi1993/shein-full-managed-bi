[Unit]
Description=SHEIN full-managed BI portal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/shein-fm/runtime/portal.enabled
ConditionPathExists=/srv/shein-fm/runtime/dashboard/dashboard.json

[Service]
Type=simple
User=sheinfm-portal
Group=sheinfm-portal
SupplementaryGroups=sheinfm-dashboard
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=FULL_BI_HOST=127.0.0.1
Environment=FULL_BI_PORT=8788
Environment=FULL_BI_TRUST_PROXY=true
Environment=FULL_BI_COOKIE_SECURE=true
Environment=FULL_BI_PUBLIC_ORIGIN=https://fm.dushengyi.cc
Environment=FULL_BI_SESSION_TTL_SECONDS=2592000
Environment=FULL_BI_DATA_FILE=/srv/shein-fm/runtime/dashboard/dashboard.json
Environment=FULL_BI_AUTH_FILE=/srv/shein-fm/secrets/portal/bi_users.json
Environment=FULL_BI_SESSION_SECRET_FILE=/srv/shein-fm/secrets/portal/session-secret
ExecStart=/usr/bin/node src/server/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/runtime/dashboard/dashboard.json
ReadOnlyPaths=/srv/shein-fm/secrets/portal/bi_users.json
ReadOnlyPaths=/srv/shein-fm/secrets/portal/session-secret
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
