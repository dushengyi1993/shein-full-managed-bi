[Unit]
Description=Refresh SHEIN full-managed read-only supply facts once daily
ConditionPathExists=/srv/shein-fm/runtime/supply-sync.enabled
ConditionPathExists=/srv/shein-fm/runtime/supply-backfill.verified

[Timer]
OnCalendar=*-*-* 03:40:00 Asia/Shanghai
RandomizedDelaySec=2m
Persistent=false
Unit=shein-fm-supply-sync.service

# Deliberately disabled by default. Enable this timer only after the deployment
# gate creates /srv/shein-fm/runtime/supply-sync.enabled.

[Install]
WantedBy=timers.target
