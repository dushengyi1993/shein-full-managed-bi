[Unit]
Description=Settle SHEIN full-managed homepage history after the hourly core window
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/all-25-completed

[Timer]
# Five short, explicit store batches run after the D-1 readiness window. The
# schedule runner
# maps the exact HH:MM slot to batch 0..4 instead of inferring from the hour.
OnCalendar=*-*-* 03:45:00 Asia/Shanghai
OnCalendar=*-*-* 04:15:00 Asia/Shanghai
OnCalendar=*-*-* 04:45:00 Asia/Shanghai
OnCalendar=*-*-* 05:15:00 Asia/Shanghai
OnCalendar=*-*-* 05:45:00 Asia/Shanghai
AccuracySec=1m
Persistent=false
Unit=shein-fm-home-daily.service

[Install]
WantedBy=timers.target
