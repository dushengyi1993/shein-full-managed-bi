[Unit]
Description=Settle SHEIN full-managed homepage history in five bounded batches
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/all-25-completed

[Timer]
# 05:20 through 09:20 map deterministically to batches 0 through 4.
OnCalendar=*-*-* 05..09:20:00 Asia/Shanghai
AccuracySec=1m
Persistent=false
Unit=shein-fm-home-daily.service

[Install]
WantedBy=timers.target
