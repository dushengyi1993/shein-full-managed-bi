[Unit]
Description=Retry missing SHEIN full-managed settled homepage facts
ConditionPathExists=/srv/shein-fm/runtime/webapi-history.enabled
ConditionPathExists=/srv/shein-fm/runtime/store-login/all-25-completed

[Timer]
OnCalendar=*-*-* 11:50:00 Asia/Shanghai
AccuracySec=1m
Persistent=false
Unit=shein-fm-home-daily-retry.service

[Install]
WantedBy=timers.target
