[Unit]
Description=Back up SHEIN full-managed PostgreSQL
Requires=shein-fm-db.service
After=shein-fm-db.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=root
Group=root
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=FULL_BI_BACKUP_DIR=/srv/shein-fm/backups/db
# Daily backup only creates and verifies the dump. Retention/COS archive has its
# own bounded post-core window, so a large copy can never extend this unit into
# the 02:10 full-managed renewal lane.
Environment=FULL_BI_SKIP_BACKUP_ARCHIVE=1
# `--mode daily` is required: the script keeps at most one successful backup per
# UTC day, so a retried timer run is a no-op instead of a second dump.
ExecStart=/usr/bin/flock -n -E 75 /run/lock/shein-host-heavy.lock /usr/bin/flock -n -E 75 /run/lock/shein-fm-heavy.lock /usr/bin/bash scripts/run_full_managed_resource_guarded.sh materializer /usr/bin/bash scripts/backup_full_managed_db.sh --mode daily
SuccessExitStatus=75
TimeoutStartSec=15min
TimeoutStopSec=20s
KillMode=control-group
Nice=10
CPUWeight=10
CPUQuota=40%
IOWeight=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=384M
MemoryMax=768M
MemorySwapMax=64M
TasksMax=96
