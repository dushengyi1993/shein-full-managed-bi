[Unit]
Description=Back up SHEIN full-managed PostgreSQL
Requires=shein-fm-db.service
After=shein-fm-db.service systemd-tmpfiles-setup.service
RequiresMountsFor=/srv/shein-fm/backups

[Service]
Type=oneshot
User=root
Group=root
Slice=shein-host-heavy-fm.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=FULL_BI_BACKUP_DIR=/srv/shein-fm/backups/db
# Weekly full dump only. Ordinary releases do not create another full backup;
# destructive migrations must request `--mode deploy` explicitly.
ExecStart=/usr/bin/bash scripts/run_shein_host_lane.sh io-heavy fm io-heavy /usr/bin/flock -n -E 75 /run/lock/shein-fm-heavy.lock /usr/bin/bash scripts/backup_full_managed_db.sh --mode weekly
SuccessExitStatus=75
TimeoutStartSec=20min
TimeoutStopSec=20s
KillMode=control-group
Nice=10
CPUWeight=10
CPUQuota=40%
IOWeight=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=384M
MemoryMax=768M
MemorySwapMax=64M
TasksMax=96
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/lock/shein-host-heavy.lock /run/lock/shein-fm-heavy.lock /srv/shein-fm/backups /srv/shein-fm/runtime
