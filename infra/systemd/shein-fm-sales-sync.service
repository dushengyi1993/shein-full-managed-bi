[Unit]
Description=Refresh SHEIN full-managed read-only sales facts
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
OnSuccess=shein-fm-dashboard-materialize.service
OnFailure=shein-fm-dashboard-materialize.service
ConditionPathExists=/srv/shein-fm/runtime/sales-sync.enabled

[Service]
Type=oneshot
User=sheinfm-sales
Group=sheinfm-sales
Slice=shein-fm-heavy.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/sales/openapi.json
EnvironmentFile=/srv/shein-fm/secrets/sales/database.env
RuntimeDirectory=shein-fm-sales
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecCondition=/usr/bin/node scripts/check_full_managed_resource_pressure.mjs --class=openapi --systemd-condition
ExecStart=/usr/bin/flock -n -E 75 /run/shein-fm-sales/sync.lock /usr/bin/node scripts/run_full_managed_scheduled_task.mjs --task=sales-hourly --execute
SuccessExitStatus=75
TimeoutStartSec=15min
TimeoutStopSec=20s
KillMode=control-group
SendSIGKILL=yes
Nice=10
CPUWeight=25
CPUQuota=60%
IOWeight=25
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMPolicy=stop
OOMScoreAdjust=400
TasksMax=96
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/sales/openapi.json
ReadOnlyPaths=/srv/shein-fm/secrets/sales/database.env
ReadWritePaths=/run/shein-fm-sales
MemoryHigh=256M
MemoryMax=512M
MemorySwapMax=64M

[Install]
WantedBy=multi-user.target
