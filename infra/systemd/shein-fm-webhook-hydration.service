[Unit]
Description=Hydrate full-managed business facts from actionable Webhooks
Wants=network-online.target
Requires=shein-fm-db.service
After=network-online.target shein-fm-db.service shein-fm-db-migrate.service systemd-tmpfiles-setup.service
OnSuccess=shein-fm-dashboard-materialize-enqueue.service
ConditionPathExists=/srv/shein-fm/runtime/webhook-hydration.enabled

[Service]
Type=oneshot
User=sheinfm-supply
Group=sheinfm-supply
Slice=shein-fm-heavy.slice
UMask=0077
WorkingDirectory=/opt/shein-fm/current
Environment=NODE_ENV=production
Environment=SHEIN_FM_CLOUD_EXECUTION=1
Environment=FULL_BI_OPENAPI_CONFIG_FILE=/srv/shein-fm/secrets/supply/openapi.json
EnvironmentFile=/srv/shein-fm/secrets/supply/database.env
RuntimeDirectory=shein-fm-webhook-hydration
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/bash scripts/run_shein_host_lane.sh api-light fm openapi /usr/bin/flock -n -E 75 /run/shein-fm-webhook-hydration/hydration.lock /usr/bin/node scripts/run_full_managed_webhook_hydration.mjs
SuccessExitStatus=75
TimeoutStartSec=15min
TimeoutStopSec=20s
KillMode=control-group
Nice=8
CPUWeight=30
CPUQuota=70%
IOWeight=30
OOMPolicy=stop
OOMScoreAdjust=300
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/shein-fm/secrets/supply/openapi.json
ReadOnlyPaths=/srv/shein-fm/secrets/supply/database.env
ReadWritePaths=/run/lock/shein-api-light-0.lock /run/lock/shein-api-light-1.lock /run/shein-fm-webhook-hydration
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=64M
