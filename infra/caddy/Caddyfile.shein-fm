http://fm.dushengyi.cc {
	redir https://fm.dushengyi.cc{uri} permanent
}

https://fm.dushengyi.cc:11443 {
	bind 127.0.0.1
	encode zstd gzip
	header -Alt-Svc
	tls {
		protocols tls1.2 tls1.3
	}
	reverse_proxy 127.0.0.1:8081 {
		# Direct HTTPS is accepted. Do not trust caller-supplied Cloudflare
		# headers; record only the immediate trusted HAProxy hop.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}
