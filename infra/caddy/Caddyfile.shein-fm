http://fm.dushengyi.cc {
	redir https://fm.dushengyi.cc{uri} permanent
}

https://fm.dushengyi.cc:11443 {
	bind 127.0.0.1
	encode zstd gzip
	header -Alt-Svc
	tls {
		protocols tls1.2 tls1.3
	}
	reverse_proxy 127.0.0.1:8081 {
		# HAProxy only admits Cloudflare peers for this SNI, so the original
		# client address supplied by Cloudflare can be trusted on this hop.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}
